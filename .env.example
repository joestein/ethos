# Copy to .env and fill in, then load into your shell before running the server:
#   set -a; source .env; set +a
# (Phoenix does not auto-load .env files — use the line above, or direnv.)

# Claude API key — used for structuring trip dumps and gap-fill (https://platform.claude.com)
ANTHROPIC_API_KEY=

# exa.ai API key — used for place enrichment, research, and gap-fill candidates (https://exa.ai)
EXA_API_KEY=

# PostHog project API key — product analytics (https://posthog.com).
# A phc_-prefixed PUBLIC client key; it ships in page source by design.
# Leave blank in dev unless you want your local clicking in the real project.
POSTHOG_PUBLIC_KEY=
