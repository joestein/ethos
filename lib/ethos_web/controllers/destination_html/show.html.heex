<div class="mx-auto max-w-2xl px-4 py-10">
  <header>
    <h1 class="text-3xl font-bold">{@name}</h1>
    <p class="mt-1 text-zinc-500">Real trip guides for {@name}.</p>
  </header>
  <section :if={@destination} class="mt-6">
    <% photo = List.first(@destination.photos) %>
    <img
      :if={photo}
      src={photo["src"]}
      alt={photo["title"]}
      class="w-full rounded-xl"
      loading="lazy"
    />
    <p :if={photo} class="mt-2 text-xs text-zinc-400">
      Photo "{photo["title"]}": {photo["author"]}, {photo["license"]}, via
      <a href={photo["source_url"]} class="underline" rel="nofollow noopener">
        Wikimedia Commons
      </a>
    </p>
    <div class="prose mt-4">{EthosWeb.Markdown.render(@destination.intro)}</div>
  </section>
  <ol class="mt-8 space-y-4">
    <li :for={guide <- @guides} class="rounded-xl border p-5">
      <.link navigate={~p"/g/#{guide.slug}"} class="font-semibold text-lg hover:underline">
        {guide.title}
      </.link>
      <p class="text-sm text-zinc-500">{guide.destination}</p>
    </li>
  </ol>
</div>
