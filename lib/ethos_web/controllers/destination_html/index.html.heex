<div class="mx-auto max-w-2xl px-4 py-10">
  <header>
    <h1 class="text-3xl font-bold">Destinations</h1>
    <p class="mt-1 text-zinc-500">Real trip guides by destination.</p>
  </header>

  <ul class="mt-8 space-y-3">
    <li :for={destination <- @destinations}>
      <.link
        navigate={~p"/destinations/#{destination.slug}"}
        class="flex items-center justify-between rounded-lg border p-4 hover:bg-zinc-50"
      >
        <span class="font-semibold">{destination.name}</span>
        <span class="text-sm text-zinc-500">{destination.count} guides</span>
      </.link>
    </li>
  </ul>
</div>
