<div class="mx-auto max-w-2xl px-4 py-10">
  <h1 class="font-display text-display-sm">Your badges</h1>
  <p class="mt-1 text-ink-muted">
    React to places you've visited to earn them.
  </p>
  <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
    <div
      :for={d <- @definitions}
      class={[
        "rounded-xl border p-4 text-center",
        if(Map.has_key?(@earned, d.key), do: "border-star bg-star/10", else: "opacity-50")
      ]}
    >
      <div class="text-3xl">{d.emoji}</div>
      <p class="mt-1 font-semibold">{d.name}</p>
      <p class="mt-1 text-xs text-ink">{d.description}</p>
      <p :if={at = @earned[d.key]} class="mt-1 text-xs text-ink">
        Earned {Calendar.strftime(at, "%b %-d, %Y")}
      </p>
    </div>
  </div>
</div>
