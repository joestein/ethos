<article class="mx-auto max-w-2xl px-4 py-10">
  <EthosWeb.GuideBreadcrumb.guide_breadcrumb guide={@guide} />

  <header class="mt-2">
    <h1 class="text-3xl font-bold">{@guide.title}</h1>
    <p class="mt-1 text-zinc-500">{@guide.destination}</p>
    <p :for={c <- @collections} class="mt-1 text-sm text-zinc-500">
      Part of <.link navigate={~p"/c/#{c.slug}"} class="underline">{c.title}</.link>
    </p>
  </header>

  <section :if={(@guide.photos || []) != []} class="mt-6">
    <div class="flex items-center justify-between">
      <h2 class="font-semibold">
        Pictures from {@guide.destination |> String.split(",") |> List.first()}
      </h2>
      <.link navigate={~p"/g/#{@guide.slug}/photos"} class="text-sm underline">
        See all {length(@guide.photos)} photos →
      </.link>
    </div>
    <div class="mt-3 grid grid-cols-4 gap-2">
      <.link :for={p <- Enum.take(@guide.photos, 4)} navigate={~p"/g/#{@guide.slug}/photos"}>
        <img
          src={p["thumb"]}
          alt={p["title"]}
          loading="lazy"
          class="aspect-square w-full rounded-lg object-cover"
        />
      </.link>
    </div>
  </section>

  <div :if={@guide.intro} class="prose mt-6">{EthosWeb.Markdown.render(@guide.intro)}</div>

  <%!-- The generic GetYourGuide CTA is the FALLBACK. A page whose geography
        resolves to a configured affiliate locale gets the widget from the app
        layout instead — one unit per page, below the content. This condition
        is not a hardcoded state check, so Rome's aside becomes Rome's widget
        the day a Rome entry lands in the registry, with no edit here.

        It asks "will a unit render?", NOT "did a locale resolve?" — the two
        differ for a locale whose :network has no component clause yet, and
        asking the weaker question suppressed this fallback on pages that then
        rendered no widget either. `unit_renders?/1` is the same predicate the
        components use. --%>
  <aside
    :if={not EthosWeb.Affiliate.unit_renders?(assigns)}
    class="mt-8 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-amber-200 bg-amber-50 p-5"
  >
    <div>
      <p class="font-semibold">Planning your own trip?</p>
      <p class="text-sm text-zinc-600">
        Browse tours, skip-the-line tickets, and day trips on GetYourGuide — booking
        through this link supports Ethos.
      </p>
    </div>
    <a
      href={gyg_partner_url()}
      rel="sponsored nofollow noopener"
      target="_blank"
      class="shrink-0 rounded-lg bg-amber-500 px-4 py-2 text-sm font-medium text-white hover:bg-amber-600"
    >
      Explore tours →
    </a>
  </aside>

  <ol class="mt-8 space-y-4">
    <li :for={entry <- @entries} id={"entry-#{entry.id}"} class="rounded-xl border p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-semibold text-lg">
            <%= cond do %>
              <% match?(%{slug: _}, entry.place) -> %>
                <.link navigate={~p"/p/#{entry.place.slug}"} class="hover:underline">
                  {entry.name}
                </.link>
              <% entry.enrichment && entry.enrichment["official_url"] &&
                   EthosWeb.Url.safe_http?(entry.enrichment["official_url"]) -> %>
                <a href={entry.enrichment["official_url"]} class="hover:underline" rel="nofollow">
                  {entry.name}
                </a>
              <% true -> %>
                {entry.name}
            <% end %>
          </p>
          <p class="text-sm text-zinc-500">
            {entry.kind}
            <span :if={entry.day}>· day {entry.day}</span>
            <span :if={verdict_badge(entry.verdict)}>· {verdict_badge(entry.verdict)}</span>
          </p>
        </div>
        <button
          type="button"
          data-copy-url={entry_share_url(@guide, entry)}
          class="shrink-0 rounded-lg border px-2 py-1 text-xs text-zinc-500 hover:bg-zinc-50"
        >
          Copy link
        </button>
      </div>

      <p :if={entry.note} class="mt-2">{entry.note}</p>

      <a
        :if={EthosWeb.Url.safe_http?(entry.booking_url)}
        href={entry.booking_url}
        rel="sponsored nofollow noopener"
        target="_blank"
        class="mt-3 inline-flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2 text-sm font-medium text-white hover:bg-amber-600"
      >
        {entry.booking_label || "Book this"} →
      </a>

      <p :if={entry.credited_user_id} class="mt-2 text-xs text-zinc-400">
        added from a reader suggestion
      </p>

      <div :if={@research[entry.id]} class="mt-3 rounded-md bg-zinc-50 p-3 text-sm">
        <p class="font-medium text-zinc-600">Fresh research</p>
        <ul class="mt-1 space-y-1">
          <li :for={r <- @research[entry.id]["results"]}>
            <%= if EthosWeb.Url.safe_http?(r["url"]) do %>
              <a href={r["url"]} class="underline" rel="nofollow">{r["title"] || r["url"]}</a>
            <% else %>
              <span>{r["title"] || r["url"]}</span>
            <% end %>
            <span :if={r["snippet"]} class="text-zinc-500">— {r["snippet"]}</span>
          </li>
        </ul>
      </div>

      <form
        :if={@current_user}
        action={~p"/g/#{@guide.slug}/entries/#{entry.id}/research"}
        method="post"
        class="mt-2"
      >
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
        <button class="text-xs underline text-zinc-500">Research this</button>
      </form>
    </li>
  </ol>

  <section :for={section <- @guide.sections || []} class="mt-10">
    <h2 class="text-xl font-semibold">{section["heading"]}</h2>
    <div class="prose mt-2">{EthosWeb.Markdown.render(section["body"])}</div>
  </section>

  <section :if={(@guide.faq || []) != []} class="mt-10">
    <h2 class="text-xl font-semibold">Frequently asked questions</h2>
    <dl class="mt-3 space-y-4">
      <div :for={item <- @guide.faq}>
        <dt class="font-medium">{Map.get(item, "question", "")}</dt>
        <dd class="text-zinc-600 mt-1">{Map.get(item, "answer", "")}</dd>
      </div>
    </dl>
  </section>

  <%!-- This page's original disclosure, and the FALLBACK half of a pair: when
        the layout renders an affiliate unit, that unit carries its own
        disclosure and this one would be the second on the page. It can also be
        false there — with the amber CTA suppressed and no entry booking_url,
        a New York guide has no booking links at all, only the widget.

        Same predicate as the amber aside above, deliberately: the two are the
        page's fallback affiliate content and appear and disappear together. --%>
  <p :if={not EthosWeb.Affiliate.unit_renders?(assigns)} class="mt-8 text-xs text-zinc-400">
    Some booking links on this page earn Ethos a commission at no extra cost to you.
  </p>

  <EthosWeb.ConnectedPages.connected_pages connected={@connected} />

  <footer class="mt-10 flex flex-wrap gap-4 border-t pt-6">
    <.link
      navigate={~p"/g/#{@guide.slug}/suggest"}
      class="rounded-md bg-zinc-900 px-4 py-2 text-white text-sm"
    >
      Suggest a place
    </.link>
    <.link navigate={~p"/guides/new"} class="rounded-md border px-4 py-2 text-sm">
      Make your own guide
    </.link>
  </footer>
</article>
