<div class="mx-auto max-w-4xl px-4 py-10">
  <header>
    <.link navigate={~p"/g/#{@guide.slug}"} class="text-sm underline">
      ← Back to the guide
    </.link>
    <h1 class="mt-2 text-3xl font-bold">
      Pictures from {@guide.destination |> String.split(",") |> List.first()} — {@guide.title}
    </h1>
  </header>

  <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-4">
    <figure :for={photo <- @photos}>
      <a href={photo["src"]} target="_blank" rel="noopener">
        <img
          src={photo["thumb"]}
          alt={photo["title"]}
          loading="lazy"
          class="aspect-square w-full rounded-lg object-cover"
        />
      </a>
      <figcaption class="mt-1">
        <p class="font-semibold text-sm">{photo["title"]}</p>
        <p :if={photo["description"]} class="text-sm text-zinc-500">{photo["description"]}</p>
        <span :if={photo["author"]} class="text-zinc-400">
          — {photo["author"]}, {photo["license"]}, via
          <a
            :if={EthosWeb.Url.safe_http?(photo["source_url"])}
            href={photo["source_url"]}
            class="underline"
            rel="nofollow noopener"
          >
            Wikimedia Commons
          </a>
          <span :if={!EthosWeb.Url.safe_http?(photo["source_url"])}>Wikimedia Commons</span>
        </span>
      </figcaption>
    </figure>
  </div>

  <.link navigate={~p"/g/#{@guide.slug}"} class="mt-8 inline-block text-sm underline">
    ← Back to the guide
  </.link>
</div>
