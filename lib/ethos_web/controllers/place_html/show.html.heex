<article class="mx-auto max-w-2xl px-4 py-10">
  <%!--
    The place's own ancestry, root-first, linked at each node's own path.
    `@geo_trail` is the same list `PlaceController` builds the BreadcrumbList
    from, so the visible trail and the JSON-LD cannot drift apart, and each
    link is the URL the hub actually serves rather than the single-slug form
    that 301s. Empty for a place with no node — nothing in the seeded corpus
    has one, since every loader resolves a `destination_path` and raises on a
    miss — and then the page simply carries no geography trail.
  --%>
  <nav :if={@geo_trail != []} class="text-sm text-ink-muted">
    <span :for={{d, i} <- Enum.with_index(@geo_trail)}>
      <span :if={i > 0}>/</span>
      <.link navigate={EthosWeb.DestinationHTML.node_path(d.path)} class="underline">
        {d.name}
      </.link>
    </span>
  </nav>

  <header class="mt-2 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="font-display text-display-sm">{@place.name}</h1>
      {live_render(@conn, EthosWeb.SocialLive,
        id: "social-place-#{@place.id}",
        session: %{"subject_type" => "place", "subject_id" => @place.id}
      )}
      <p class="mt-1 text-ink-muted">{kind_label(@place.kind)} · {geo_label(@geo_trail)}</p>
    </div>
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-copy-url={url(~p"/p/#{@place.slug}")}
        class="rounded-lg border border-line px-3 py-1.5 text-sm hover:bg-surface-raised"
      >
        Copy link
      </button>
    </div>
  </header>

  <p
    :if={@place.status == "closed"}
    class="mt-4 rounded-lg border border-negative/30 bg-negative/10 p-3 text-sm text-ink"
  >
    Permanently closed. This page is kept for reference.
  </p>

  <img
    :if={first = List.first(@place.photos)}
    src={first["src"]}
    alt={first["title"]}
    class="mt-6 w-full rounded-xl"
  />

  <div class="prose mt-6">{EthosWeb.Markdown.render(@place.summary)}</div>

  <section :if={@place.history} class="mt-8">
    <h2 class="text-xl font-semibold">History</h2>
    <div class="prose mt-2">{EthosWeb.Markdown.render(@place.history)}</div>
  </section>

  <section class="mt-8 rounded-xl border border-line p-5 text-sm">
    <h2 class="font-semibold">Visit</h2>
    <p :if={@place.address} class="mt-2 text-ink-muted">{@place.address}</p>
    <p :if={EthosWeb.Url.safe_http?(@place.official_url)} class="mt-2">
      <a href={@place.official_url} class="underline" rel="nofollow">Official website</a>
    </p>
  </section>

  <section :if={length(@place.photos) > 1} class="mt-8">
    <h2 class="text-xl font-semibold">Photos</h2>
    <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
      <figure :for={p <- Enum.drop(@place.photos, 1)}>
        <a href={p["src"]} target="_blank" rel="noopener">
          <img src={p["thumb"]} alt={p["title"]} loading="lazy" class="w-full rounded-lg" />
        </a>
        <figcaption class="mt-1 text-xs text-ink-muted">{p["title"]}</figcaption>
      </figure>
    </div>
  </section>

  <section :if={@place.photos != []} class="mt-4 text-xs text-ink-muted">
    <p :for={p <- @place.photos}>
      Photo "{p["title"]}": {p["author"]}, {p["license"]}, via
      <a href={p["source_url"]} class="underline" rel="nofollow noopener">Wikimedia Commons</a>
    </p>
  </section>

  <section :if={@featured_guides != []} class="mt-8">
    <h2 class="text-xl font-semibold">Featured in these guides</h2>
    <ul class="mt-3 space-y-2">
      <li :for={g <- @featured_guides}>
        <.link navigate={~p"/g/#{g.slug}"} class="underline">{g.title}</.link>
      </li>
    </ul>
  </section>

  <section :if={@siblings != []} class="mt-8">
    <h2 class="text-xl font-semibold">More in {locality(@geo_trail)}</h2>
    <ul class="mt-3 space-y-2">
      <li :for={s <- @siblings}>
        <.link navigate={~p"/p/#{s.slug}"} class="underline">{s.name}</.link>
        <span class="text-sm text-ink-muted">· {kind_label(s.kind)}</span>
      </li>
    </ul>
  </section>

  <EthosWeb.ConnectedPages.connected_pages connected={@connected} />
</article>
