<EthosWeb.Layouts.site_header current_user={assigns[:current_user]} />
<%!-- The house ad is called here as well as in app.html.heex because this page
      renders with `layout: false` (page_controller.ex) and so never passes
      through that layout at all. Its own `text-center` would centre the card's
      contents, so the ad sits in its own left-aligned container above the hero
      rather than inside it. --%>
<div class="mx-auto max-w-3xl pt-20 text-left">
  <EthosWeb.HouseAd.house_ad ad={EthosWeb.HouseAd.for_page(assigns)} />
</div>
<div class="bg-gradient-to-b from-accent-soft to-surface">
  <div class="mx-auto max-w-3xl px-4 pb-12 pt-16 text-center">
    <h1 class="font-display text-display-lg text-ink">
      Places worth the trip, and what people made of them
    </h1>
    <p class="mt-4 text-lg text-ink">
      Guides to towns, neighbourhoods and the places inside them — written up properly, then
      rated and argued over by the people who went.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <.link
        navigate={~p"/destinations"}
        class="rounded-md bg-accent px-6 py-3 text-accent-ink font-medium"
      >
        Browse destinations
      </.link>
      <.link
        :if={@featured}
        href={~p"/g/#{@featured.slug}"}
        class="rounded-md border border-line px-6 py-3 font-medium"
      >
        See an example
      </.link>
    </div>
  </div>
</div>

<div class="mx-auto max-w-3xl px-4 pb-20 text-center">
  <div
    :if={@featured}
    class="mt-8 rounded-2xl border border-line bg-surface-raised p-6 shadow-sm transition hover:shadow-md text-left"
  >
    <p class="text-sm uppercase tracking-wide text-ink-muted">Featured guide</p>
    <p class="mt-1 text-xl font-semibold">{@featured.title}</p>
    <p class="text-ink-muted">{@featured.destination}</p>
    <.link href={~p"/g/#{@featured.slug}"} class="mt-3 inline-block underline">Read it →</.link>
  </div>

  <p class="mt-8 text-sm text-ink-muted">
    In season:
    <.link navigate={~p"/foliage"} class="underline">the Connecticut Foliage Forecast</.link>
    — when the leaves turn in each of the state's 169 towns.
  </p>

  <section :if={@latest != []} class="mt-12 text-left">
    <div class="flex items-center justify-between">
      <h2 class="text-sm uppercase tracking-wide text-ink-muted">Latest guides</h2>
      <.link navigate={~p"/destinations"} class="text-sm underline">
        Browse all destinations →
      </.link>
    </div>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      <li
        :for={g <- @latest}
        class="rounded-2xl border border-line bg-surface-raised p-6 shadow-sm transition hover:shadow-md"
      >
        <.link href={~p"/g/#{g.slug}"} class="font-semibold hover:underline">{g.title}</.link>
        <p class="text-sm text-ink-muted">{g.destination}</p>
      </li>
    </ul>
  </section>

  <section :if={@hubs != []} class="mt-12 text-left">
    <div class="flex items-center justify-between">
      <h2 class="text-sm uppercase tracking-wide text-ink-muted">Travel Guides</h2>
      <.link navigate={~p"/destinations"} class="text-sm underline">
        All {@hub_count} destinations →
      </.link>
    </div>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      <li :for={hub <- @hubs} class="rounded-xl border p-4">
        <%!-- node_path/1, never ~p"/destinations/\#{hub.path}" — the sigil
              percent-encodes the slash and a multi-segment path 404s. --%>
        <.link
          navigate={EthosWeb.DestinationHTML.node_path(hub.path)}
          class="font-semibold hover:underline"
        >
          {hub.name}
        </.link>
        <p class="text-sm text-ink-muted">{hub.count} {hub_noun(hub.slug)}</p>
      </li>
    </ul>
  </section>

  <section :if={@collections != []} class="mt-12 text-left">
    <h2 class="text-sm uppercase tracking-wide text-ink-muted">Collections</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      <li :for={c <- @collections} class="rounded-xl border p-4">
        <.link navigate={~p"/c/#{c.slug}"} class="font-semibold hover:underline">{c.title}</.link>
      </li>
    </ul>
  </section>

  <section :if={@foliage_routes != []} class="mt-12 text-left">
    <div class="flex items-center justify-between">
      <h2 class="text-sm uppercase tracking-wide text-ink-muted">Foliage driving routes</h2>
      <.link navigate={~p"/foliage"} class="text-sm underline">The forecast →</.link>
    </div>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      <li :for={route <- @foliage_routes} class="rounded-xl border p-4">
        <.link navigate={~p"/foliage/#{route.slug}"} class="font-semibold hover:underline">
          {route.name}
        </.link>
        <p class="text-sm text-ink-muted">{length(route.stops)} towns</p>
      </li>
    </ul>
  </section>
</div>
