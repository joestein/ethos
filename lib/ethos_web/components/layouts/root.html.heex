<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]" data-season={assigns[:season] || "summer"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%= if gsv = Application.get_env(:ethos, :google_site_verification) do %>
      <meta name="google-site-verification" content={gsv} />
    <% end %>
    <%= if assigns[:noindex] do %>
      <meta name="robots" content="noindex" />
    <% end %>
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1129507921747579"
      crossorigin="anonymous"
    >
    </script>
    <EthosWeb.Affiliate.affiliate_head locale={EthosWeb.Affiliate.locale_from_assigns(assigns)} />
    <.live_title suffix=" · Ethos">
      {assigns[:page_title] || "Ethos"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <%= if assigns[:page_og] do %>
      <meta property="og:title" content={@page_og.title} />
      <meta property="og:description" content={@page_og.description} />
      <meta property="og:type" content={Map.get(@page_og, :type, "website")} />
      <%= if Map.get(@page_og, :url) do %>
        <meta property="og:url" content={@page_og.url} />
      <% end %>
      <%= if @page_og.image do %>
        <meta property="og:image" content={@page_og.image} />
      <% end %>
      <%!-- A large-image card with no image is a promise the page cannot keep:
            every page whose page_og carries no image (the home page, the
            destinations index, a hub with no Destination photo, a guide with no
            generated OG card, a place with no photos) declared one anyway. --%>
      <meta
        name="twitter:card"
        content={if @page_og.image, do: "summary_large_image", else: "summary"}
      />
    <% end %>
    <%= if assigns[:page_meta_description] do %>
      <meta name="description" content={@page_meta_description} />
    <% end %>
    <%= if assigns[:page_canonical] do %>
      <link rel="canonical" href={@page_canonical} />
    <% end %>
    <%= for ld <- assigns[:json_ld] || [] do %>
      <script type="application/ld+json">
        <%= Phoenix.HTML.raw(Jason.encode!(ld, escape: :html_safe)) %>
      </script>
    <% end %>
  </head>
  <body class="bg-white">
    <ul class="relative z-10 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end">
      <%= if @current_user do %>
        <li class="text-[0.8125rem] leading-6 text-zinc-900">
          <%= if Ethos.Accounts.needs_username?(@current_user) do %>
            <.link href={~p"/users/username"} class="font-semibold underline">
              Pick a username
            </.link>
          <% else %>
            {@current_user.username}
          <% end %>
        </li>
        <li>
          <.link
            href={~p"/users/settings"}
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            Settings
          </.link>
        </li>
        <li>
          <.link
            href={~p"/users/log_out"}
            method="delete"
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            Log out
          </.link>
        </li>
      <% else %>
        <li>
          <.link
            href={~p"/users/register"}
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            Register
          </.link>
        </li>
        <li>
          <.link
            href={~p"/users/log_in"}
            class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
          >
            Log in
          </.link>
        </li>
      <% end %>
    </ul>
    {@inner_content}
  </body>
</html>
